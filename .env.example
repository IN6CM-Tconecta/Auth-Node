# =============================================================
#  TransmetroConecta — Auth-Node Service
#  Plantilla de variables de entorno
#  Copiar a .env: cp .env.example .env
#
#  NOTA DE PUERTOS:
#    Desarrollo local (npm run dev) → PORT=5001
#    Docker / Producción            → PORT=8080 (inyectado por docker-compose)
# =============================================================

NODE_ENV=development

# Puerto de escucha del servidor Express
# En Docker este valor es sobreescrito a 8080 por docker-compose.yml
PORT=5001

# ─────────────────────────────────────────────────────────────
# PostgreSQL — ConnectionStrings:DefaultConnection (paridad .NET)
# En Docker usar DATABASE_URL con el hostname del servicio en Compose.
# En desarrollo local usar las variables DB_* individuales.
# ─────────────────────────────────────────────────────────────

# Docker: usar hostname del servicio Compose (postgres-db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/TransmetroAuthDb

# Desarrollo local (variables individuales, usadas si DATABASE_URL está vacía)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=TransmetroAuthDb
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ─────────────────────────────────────────────────────────────
# JWT — Paridad exacta con appsettings.json → Jwt:*
# Estos valores DEBEN coincidir con todos los demás microservicios
# que validan tokens del Auth-Server (server-admin, server-client, etc.)
# ─────────────────────────────────────────────────────────────
JWT_SECRET=A_SUPER_SECRET_KEY_FOR_TRANSMETRO_CONECTA_12345
JWT_ISSUER=TransmetroAuthServer
JWT_AUDIENCE=TransmetroUsers

# Duración de tokens (formato de jsonwebtoken: Xh, Xm, Xd)
JWT_EXPIRES_IN=2h
JWT_RESET_EXPIRES_IN=15m

# ─────────────────────────────────────────────────────────────
# Wallet Microservice S2S — WalletService:BaseUrl (paridad .NET)
# En Docker usar el nombre del servicio Compose (server-client).
# En desarrollo local apuntar a localhost.
# ─────────────────────────────────────────────────────────────
WALLET_SERVICE_URL=http://server-client:3002
INTERNAL_SECRET=SuperSecretS2S_Transmetro2026

# ─────────────────────────────────────────────────────────────
# CORS — Orígenes permitidos (separados por coma)
# Incluir todos los orígenes de los frontends y otros servicios
# ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:4200
